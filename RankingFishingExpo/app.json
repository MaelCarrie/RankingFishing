{
  "expo": {
    "name": "RankingFishing",
    "slug": "rankingfishing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F5F0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rankingfishing.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#021124"
      },
      "package": "com.rankingfishing.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "RankingFishing accède à vos photos pour que vous puissiez partager vos captures."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RankingFishing accède à votre position pour géolocaliser vos captures (fonctionnalité Premium)."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#021124",
          "imageWidth": 200
        }
      ]
    ],
    "scheme": "rankingfishing"
  }
}
